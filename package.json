{
  "name": "no-homework-web",
  "version": "2.2.0",
  "private": true,
  "description": "No Homework — Realistic A4/A5 notebook with GPU-accelerated rendering",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "echo 'No linting configured yet'",
    "cap:init": "cap init",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:sync:android": "cap sync android",
    "cap:sync:ios": "cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:copy": "cap copy",
    "cap:copy:android": "cap copy android",
    "cap:copy:ios": "cap copy ios",
    "cap:update": "cap update",
    "cap:update:android": "cap update android",
    "cap:update:ios": "cap update ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "atrament": "^5.1.0",
    "handwritten.js": "^18.11.3",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "keywords": [
    "notebook",
    "paper",
    "a4",
    "a5",
    "drawing",
    "canvas",
    "webgl",
    "gpu",
    "capacitor",
    "pwa"
  ],
  "author": "kg24ghrt-ops",
  "license": "MIT",
  "homepage": "https://github.com/kg24ghrt-ops/No-homework-web-",
  "repository": {
    "type": "git",
    "url": "https://github.com/kg24ghrt-ops/No-homework-web-.git"
  },
  "bugs": {
    "url": "https://github.com/kg24ghrt-ops/No-homework-web-/issues"
  }
}
